{
  "name": "notion-sprint-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test:kpi-progress": "npx -y tsx scripts/test-kpi-progress.ts",
    "test:sp-dashboard": "npx -y tsx scripts/test-sp-gamification.ts",
    "test:delivery-control": "npx -y tsx scripts/test-delivery-control.ts",
    "test:sprint-planning": "npx -y tsx scripts/test-sprint-planning-assistant.ts",
    "loop:audit": "npx -y @cobusgreyling/loop-audit . --suggest",
    "loop:cost": "npx -y @cobusgreyling/loop-cost --pattern daily-triage --level L1"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.4.5",
    "wrangler": "^4.54.0"
  }
}
